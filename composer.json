{
    "name": "alex-kassel/dev-kit",
    "description": "Development workspace tools for modular Laravel applications.",
    "keywords": [
        "laravel",
        "dev-kit",
        "monorepo",
        "package-development",
        "tooling"
    ],
    "homepage": "https://github.com/alex-kassel/dev-kit",
    "support": {
        "issues": "https://github.com/alex-kassel/dev-kit/issues",
        "source": "https://github.com/alex-kassel/dev-kit"
    },
    "authors": [
        {
            "name": "Alex Kassel",
            "role": "Developer"
        }
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.1",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "symfony/process": "^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "AlexKassel\\DevKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexKassel\\DevKit\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlexKassel\\DevKit\\DevKitServiceProvider"
            ]
        }
    }
}
